# Copy to .env. No provider keys are stored in project/story JSON.
NOVEL_API_BASE_URL=https://api.deepseek.com
NOVEL_API_KEY=
# Use an actual model available at your endpoint; there is no assumed default.
NOVEL_MODEL=deepseek-flash
# Optional independent models, otherwise all inherit NOVEL_MODEL.
# NOVEL_CHARACTER_MODEL=
# NOVEL_WRITER_MODEL=
# NOVEL_STYLE_MODEL=
# NOVEL_OUTLINE_MODEL=
# NOVEL_EDITOR_MODEL=
# NOVEL_DIRECTOR_MODEL=
# NOVEL_MEMORY_MODEL=
NOVEL_API_TIMEOUT=180
NOVEL_MAX_OUTPUT_TOKENS=6000
# Set max_completion_tokens for models that require that parameter.
NOVEL_TOKEN_FIELD=max_tokens
# Set off if the provider does not support response_format=json_object.
NOVEL_JSON_MODE=on
# Temperature is omitted by default for wider endpoint compatibility.
# NOVEL_TEMPERATURE=0.7

# 可选：小说导入和设定提取模型（省略时使用 NOVEL_MODEL）
# NOVEL_IMPORTER_MODEL=

# Context and bounded output recovery
NOVEL_MAX_OUTPUT_TOKENS_CEILING=24000
NOVEL_CONTEXT_WINDOW=131072
NOVEL_THINKING=auto
